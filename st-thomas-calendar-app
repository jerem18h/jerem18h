# Track processed PDF hashes
PROCESSED_HASHES_FILE = "processed_files.json"
try:
    with open(PROCESSED_HASHES_FILE, "r") as f:
        processed_hashes = set(json.load(f))
except FileNotFoundError:
    processed_hashes = set()

def save_processed_hashes():
    with open(PROCESSED_HASHES_FILE, "w") as f:
        json.dump(list(processed_hashes), f)

def hash_file(file_bytes):
    return hashlib.sha256(file_bytes).hexdigest()

def extract_events_from_text(text):
    lines = text.split("\n")
    events = []
    current_month_year = None
    date_context = None

    months = ["June", "July", "August", "September", "October"]
    for line in lines:
        line = line.strip()

        # Detect month header
        for month in months:
            if month in line and "2025" in line:
                current_month_year = f"{month} 2025"

        date_match = re.match(r"^(\d{1,2})\b", line)
        if date_match and current_month_year:
            day = int(date_match.group(1))
            try:
                date_context = datetime.strptime(f"{current_month_year} {day}", "%B %Y %d").date()
            except:
                continue

        if date_context:
            keywords = [
                ("Church School", "08:30"),
                ("Orthros", "08:30"),
                ("Divine Liturgy", "09:30"),
                ("Div. Lit.", "09:30"),
                ("9th Hour", "18:20"),
                ("Vespers", "18:30"),
                ("Paraklesis", "07:00"),
                ("Men’s Fellowship", "07:00"),
                ("Choir Practice", "17:30"),
                ("Noon Catechism", "12:00"),
                ("Catechism at the Sommer’s", "12:00"),
            ]
            for keyword, time_str in keywords:
                if keyword in line and "No " not in line:
                    event = Event()
                    event.name = keyword
                    event.begin = f"{date_context} {time_str}"
                    event.duration = timedelta(minutes=60)
                    events.append(event)
    return events

def get_latest_calendar_pdf_from_site(page_url):
    res = requests.get(page_url)
    soup = BeautifulSoup(res.text, "html.parser")

    pdf_links = [
        a["href"] for a in soup.find_all("a", href=True)
        if ".pdf" in a["href"].lower() and (
            "calendar" in a["href"].lower() or any(month in a["href"] for month in ["June", "July", "August", "September", "October"])
        )
    ]

    if not pdf_links:
        return None

    latest_link = pdf_links[0]
    if latest_link.startswith("/"):
        base = requests.utils.urlparse(page_url)
        latest_link = f"{base.scheme}://{base.netloc}{latest_link}"

    return latest_link

